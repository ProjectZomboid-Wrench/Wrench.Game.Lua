<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Zomboid.Lua</RootNamespace>
        <NoWarn>$(NoWarn);CS0108;CS0114</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wrench.Host" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Wrench.Api" Version="$(WrenchApiVersion)" />
        <PackageReference Include="Wrench.Game.Java" Version="$(WrenchGameJavaVersion)" />
    </ItemGroup>

</Project>
